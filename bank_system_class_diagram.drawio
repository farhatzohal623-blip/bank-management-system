                <mxCell id="legend" value="&lt;b&gt;OOP Concepts Demonstrated:&lt;/b&gt;&#xa;&#xa;• &lt;b&gt;Abstraction:&lt;/b&gt; Account is abstract class&#xa;• &lt;b&gt;Inheritance:&lt;/b&gt; SavingsAccount, CheckingAccount extend Account&#xa;• &lt;b&gt;Encapsulation:&lt;/b&gt; Private (__), Protected (_) attributes&#xa;• &lt;b&gt;Polymorphism:&lt;/b&gt; withdraw(), get_account_type() methods&#xa;• &lt;b&gt;Composition:&lt;/b&gt; Customer has Accounts, Bank has Customers/Accounts&#xa;• &lt;b&gt;Singleton Pattern:&lt;/b&gt; Bank class ensures single instance&#xa;• &lt;b&gt;Factory Pattern:&lt;/b&gt; create_savings_account(), create_checking_account()&#xa;• &lt;b&gt;Magic Methods:&lt;/b&gt; __str__, __repr__, __eq__, __lt__, __len__" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="710" y="1110" width="440" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="patterns-legend" value="&lt;b&gt;Design Patterns:&lt;/b&gt;&#xa;&#xa;• &lt;b&gt;Singleton Pattern:&lt;/b&gt; Bank class uses __new__ to ensure only one instance&#xa;• &lt;b&gt;Factory Pattern:&lt;/b&gt; Static methods create different account types&#xa;• &lt;b&gt;Template Method:&lt;/b&gt; Account defines common deposit() method&#xa;• &lt;b&gt;Strategy Pattern:&lt;/b&gt; Different withdraw() implementations" style="text;html=1;strokeColor=#666666;fillColor=#e8f5e8;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="1210" y="1110" width="429" height="120" as="geometry"/>
                </mxCell>
